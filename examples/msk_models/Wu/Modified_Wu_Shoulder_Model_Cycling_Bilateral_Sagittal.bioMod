version 4

// Bilateral hand-cycling reference geometry in two parallel sagittal planes.
// x is fore-aft, y is lateral (right/left), and z is vertical. The two arm
// chains have independent shoulder/elbow coordinates and share one crank
// rotating about the lateral y axis.

gravity 0 0 -9.8

segment thorax
    parent ground
    RT 0 0 0 xyz 0 0 0
    mass 20
    inertia
        1.4745 0 0
        0 0.7555 0
        0 0 1.4314
    com 0 0 0
endsegment

// Both shoulders have the same anatomical height. y only separates sides.
segment right_humerus
    parent thorax
    RT 0 0 0 xyz 0 -0.10 0
    mass 2.0325
    inertia
        0.011946 0 0
        0 0.004121 0
        0 0 0.013409
    com 0 0 -0.164502
    rotations y
    ranges -3 3
endsegment

segment right_ulna
    parent right_humerus
    RT 0 0 0 xyz 0 0 -0.2904
    mass 0.6075
    inertia
        0.002962 0 0
        0 0.000618 0
        0 0 0.003213
    com 0 0 -0.120525
    rotations y
    ranges -1 3
endsegment

segment left_humerus
    parent thorax
    RT 0 0 0 xyz 0 0.10 0
    mass 2.0325
    inertia
        0.011946 0 0
        0 0.004121 0
        0 0 0.013409
    com 0 0 -0.164502
    rotations y
    ranges -3 3
endsegment

segment left_ulna
    parent left_humerus
    RT 0 0 0 xyz 0 0 -0.2904
    mass 0.6075
    inertia
        0.002962 0 0
        0 0.000618 0
        0 0 0.003213
    com 0 0 -0.120525
    rotations y
    ranges -1 3
endsegment

variables
    $wheel_radius 0.10
    $wheel_x_position 0.35
    $handle_lateral_offset 0.10
endvariables

segment wheel_rotation
    parent thorax
    RT 0 0 0 xyz $wheel_x_position 0 0
    rotations y
    rangesQ -40*pi 4*pi
endsegment

segment wheel
    parent wheel_rotation
    RT 0 0 0 xyz 0 0 0
    mass 0.5
    inertia
        0.001254 0 0
        0 0.001254 0
        0 0 0.0025
    com 0 0 0
endsegment

contact Wheel_center_contact
    parent wheel
    position 0 0 0
    axis xz
endcontact

marker wheel_center
    parent wheel
    position 0 0 0
endmarker

// The two handles are diametrically opposed in x-z and stay on their arm's
// lateral plane. This keeps the six-dimensional bilateral contact residual
// exact while each arm still has only two sagittal DoFs.
marker right_handle
    parent wheel
    position -$wheel_radius -$handle_lateral_offset 0
endmarker

marker left_handle
    parent wheel
    position $wheel_radius $handle_lateral_offset 0
endmarker

marker right_hand
    parent right_ulna
    position 0 0 -0.25
endmarker

marker left_hand
    parent left_ulna
    position 0 0 -0.25
endmarker

// The paths below are deliberately planar seed paths. They preserve bilateral
// symmetry and give an auditable starting point for future participant-specific
// origin/insertion and tendon-length calibration.
musclegroup right_shoulder_to_humerus
    OriginParent thorax
    InsertionParent right_humerus
endmusclegroup

muscle right_Delt_ant
    type degroote
    statetype degroote
    musclegroup right_shoulder_to_humerus
    OriginPosition -0.05 -0.10 0.06
    InsertionPosition 0 0 0.04
    optimalLength 0.1752
    maximalForce 556.8
    tendonSlackLength 0.0313
    pennationAngle 0.383972435439
endmuscle

viapoint right_Delt_ant_P1
    parent thorax
    muscle right_Delt_ant
    musclegroup right_shoulder_to_humerus
    position 0.01 -0.10 0.10
endviapoint

muscle right_Delt_post
    type degroote
    statetype degroote
    musclegroup right_shoulder_to_humerus
    OriginPosition -0.07 -0.10 -0.05
    InsertionPosition 0 0 -0.12
    optimalLength 0.1747
    maximalForce 325.5
    tendonSlackLength 0.0359
    pennationAngle 0.314159265359
endmuscle

viapoint right_Delt_post_P1
    parent thorax
    muscle right_Delt_post
    musclegroup right_shoulder_to_humerus
    position -0.02 -0.10 -0.08
endviapoint

musclegroup right_shoulder_to_ulna
    OriginParent thorax
    InsertionParent right_ulna
endmusclegroup

muscle right_Biceps
    type degroote
    statetype degroote
    musclegroup right_shoulder_to_ulna
    OriginPosition -0.04 -0.10 0.03
    InsertionPosition 0 0 -0.04
    optimalLength 0.11600000000000001
    maximalForce 461.40000000000003
    tendonSlackLength 0.2723
    pennationAngle 0
endmuscle

viapoint right_Biceps_elbow
    parent right_humerus
    muscle right_Biceps
    musclegroup right_shoulder_to_ulna
    position 0 0 -0.28
endviapoint

musclegroup right_humerus_to_ulna
    OriginParent right_humerus
    InsertionParent right_ulna
endmusclegroup

muscle right_Triceps
    type degroote
    statetype degroote
    musclegroup right_humerus_to_ulna
    OriginPosition 0 0 -0.04
    InsertionPosition 0 0 -0.08
    optimalLength 0.13419999999999999
    maximalForce 707.69999999999993
    tendonSlackLength 0.14320000000000002
    pennationAngle 0.2094
endmuscle

viapoint right_Triceps_elbow
    parent right_humerus
    muscle right_Triceps
    musclegroup right_humerus_to_ulna
    position 0.02 0 -0.27
endviapoint

musclegroup left_shoulder_to_humerus
    OriginParent thorax
    InsertionParent left_humerus
endmusclegroup

muscle left_Delt_ant
    type degroote
    statetype degroote
    musclegroup left_shoulder_to_humerus
    OriginPosition -0.05 0.10 0.06
    InsertionPosition 0 0 0.04
    optimalLength 0.1752
    maximalForce 556.8
    tendonSlackLength 0.0313
    pennationAngle 0.383972435439
endmuscle

viapoint left_Delt_ant_P1
    parent thorax
    muscle left_Delt_ant
    musclegroup left_shoulder_to_humerus
    position 0.01 0.10 0.10
endviapoint

muscle left_Delt_post
    type degroote
    statetype degroote
    musclegroup left_shoulder_to_humerus
    OriginPosition -0.07 0.10 -0.05
    InsertionPosition 0 0 -0.12
    optimalLength 0.1747
    maximalForce 325.5
    tendonSlackLength 0.0359
    pennationAngle 0.314159265359
endmuscle

viapoint left_Delt_post_P1
    parent thorax
    muscle left_Delt_post
    musclegroup left_shoulder_to_humerus
    position -0.02 0.10 -0.08
endviapoint

musclegroup left_shoulder_to_ulna
    OriginParent thorax
    InsertionParent left_ulna
endmusclegroup

muscle left_Biceps
    type degroote
    statetype degroote
    musclegroup left_shoulder_to_ulna
    OriginPosition -0.04 0.10 0.03
    InsertionPosition 0 0 -0.04
    optimalLength 0.11600000000000001
    maximalForce 461.40000000000003
    tendonSlackLength 0.2723
    pennationAngle 0
endmuscle

viapoint left_Biceps_elbow
    parent left_humerus
    muscle left_Biceps
    musclegroup left_shoulder_to_ulna
    position 0 0 -0.28
endviapoint

musclegroup left_humerus_to_ulna
    OriginParent left_humerus
    InsertionParent left_ulna
endmusclegroup

muscle left_Triceps
    type degroote
    statetype degroote
    musclegroup left_humerus_to_ulna
    OriginPosition 0 0 -0.04
    InsertionPosition 0 0 -0.08
    optimalLength 0.13419999999999999
    maximalForce 707.69999999999993
    tendonSlackLength 0.14320000000000002
    pennationAngle 0.2094
endmuscle

viapoint left_Triceps_elbow
    parent left_humerus
    muscle left_Triceps
    musclegroup left_humerus_to_ulna
    position 0.02 0 -0.27
endviapoint
