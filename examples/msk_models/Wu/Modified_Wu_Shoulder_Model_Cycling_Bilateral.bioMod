    musclegroup right_shoulder_to_ulna
    position 0.023584999999999998 -0.29429899999999998 -0.0112797
endviapoint

musclegroup right_humerus_to_ulna
    OriginParent right_humerus
    InsertionParent right_ulna
endmusclegroup

muscle right_Triceps
    type degroote
    statetype degroote
    musclegroup right_humerus_to_ulna
    OriginPosition 0 -0.08 0
    InsertionPosition 0 -0.03 0
    optimalLength 0.165
    maximalForce 798.52
    tendonSlackLength 0.1484
    pennationAngle 0.2094
endmuscle

viapoint right_Triceps_P2
    parent right_humerus
    muscle right_Triceps
    musclegroup right_humerus_to_ulna
    position -0.020547800000000001 -0.26594699999999999 -0.0091203099999999995
endviapoint
viapoint right_Triceps_P3
    parent right_humerus
    muscle right_Triceps
    musclegroup right_humerus_to_ulna
    position -0.018969799999999998 -0.29120699999999999 -0.0131472
endviapoint

// Left-muscle geometry is the y-reflection of the right chain.
musclegroup left_shoulder_to_humerus
    OriginParent thorax
    InsertionParent left_humerus
