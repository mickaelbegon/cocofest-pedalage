{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial physiological weights and static/adaptive policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["initial_weights", "initial_weight_basis"],
  "properties": {
    "initial_weight_basis": {"type": "string", "pattern": "\\S"},
    "initial_weights": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "adaptation_enabled": {"type": "boolean", "default": true},
        "update_every_cycles": {"type": "integer", "minimum": 1, "default": 5},
        "smoothing": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.2},
        "capacity_gain": {"type": "number", "exclusiveMinimum": 0, "default": 1},
        "min_relative_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.25},
        "max_relative_weight": {"type": "number", "minimum": 1, "default": 4},
        "max_log_step": {"type": "number", "exclusiveMinimum": 0},
        "max_cycles": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}
      }
    }
  }
}
